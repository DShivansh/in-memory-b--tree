{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug btree_demo",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/btree_demo",
      "cwd": "${workspaceFolder}",
      "args": [],
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for C++ containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": false
        }
      ],
      "externalConsole": false
    }
  ]
}
